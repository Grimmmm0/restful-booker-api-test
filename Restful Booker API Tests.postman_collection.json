          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking updated successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.firstname).to.eql(\"Mohad Updated\");\r\n    pm.expect(response.totalprice).to.eql(1800);\r\n});"
            ]
          }
        }
      ],
