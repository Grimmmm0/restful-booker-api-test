          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Booking retrieved successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking contains updated information\", function () {\r\n    pm.expect(response.firstname).to.eql(\"Mohad Updated\");\r\n    pm.expect(response.lastname).to.eql(\"Matanog\");\r\n    pm.expect(response.totalprice).to.eql(1800);\r\n    pm.expect(response.additionalneeds).to.eql(\"Breakfast and Lunch\");\r\n});"
            ]
          }
        }
      ],
