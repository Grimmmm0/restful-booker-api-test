      "name": "01 - Create Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.collectionVariables.set(\"token\", response.token);\r\n\r\npm.test(\"Authentication successful\", function () {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(response.token).to.exist;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
