              "const response = pm.response.json();\r\n\r\npm.test(\"Invalid credentials are rejected\", function () {\r\n    pm.expect(response.reason).to.eql(\"Bad credentials\");\r\n});\r\n\r\npm.test(\"Authentication token is not returned\", function () {\r\n    pm.expect(response.token).to.be.undefined;\r\n});"
