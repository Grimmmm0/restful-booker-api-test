        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Mohad Updated\",\r\n  \"lastname\": \"Matanog\",\r\n  \"totalprice\": 1800,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-12-01\",\r\n    \"checkout\": \"2026-12-06\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast and Lunch\"\r\n}",
